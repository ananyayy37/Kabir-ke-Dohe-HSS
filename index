<script>
document.addEventListener('DOMContentLoaded', function () {
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- progress thread + status bar ---------- */
  var progressEl = document.getElementById('progressThread');
  function updateProgress () {
    var h = document.documentElement;
    var scrollable = h.scrollHeight - h.clientHeight;
    var pct = scrollable > 0 ? (h.scrollTop || document.body.scrollTop) / scrollable * 100 : 0;
    progressEl.style.width = pct + '%';
  }
  document.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  var bugCountEl = document.getElementById('bugCount');
  var bugsFound = 0;
  function markBugFound () {
    bugsFound = Math.min(2, bugsFound + 1);
    bugCountEl.textContent = bugsFound;
  }

  /* ---------- landing terminal ---------- */
  var terminalEl = document.getElementById('terminal');
  var runBtn = document.getElementById('runBtn');
  var lines = ['Initialising...', 'Scanning behaviour...', '2 issues detected.'];

  function typeLines (lines, onDone) {
    var lineIndex = 0;
    function nextLine () {
      if (lineIndex >= lines.length) { onDone(); return; }
      var p = document.createElement('div');
      p.className = 'line';
      terminalEl.appendChild(p);
      var text = lines[lineIndex];
      var charIndex = 0;
      function typeChar () {
        if (charIndex <= text.length) {
          p.textContent = text.slice(0, charIndex);
          charIndex++;
          setTimeout(typeChar, 26);
        } else {
          lineIndex++;
          setTimeout(nextLine, 380);
        }
      }
      typeChar();
    }
    nextLine();
  }

  if (reduceMotion) {
    lines.forEach(function (t) {
      var p = document.createElement('div');
      p.className = 'line';
      p.textContent = t;
      terminalEl.appendChild(p);
    });
    runBtn.disabled = false;
    runBtn.classList.add('ready');
  } else {
    var cursor = document.createElement('span');
    cursor.className = 'cursor';
    terminalEl.appendChild(cursor);
    typeLines(lines, function () {
      runBtn.disabled = false;
      runBtn.classList.add('ready');
    });
  }

  runBtn.addEventListener('click', function () {
    var target = document.getElementById('why');
    if (target) target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
  });

  /* ---------- bug 01: choice + doha reveal ---------- */
  var choiceRow = document.getElementById('choiceRow');
  var reveal01 = document.getElementById('reveal-bug01');
  var choiceResponse = document.getElementById('choiceResponse');
  var bug01Revealed = false;

  choiceRow.addEventListener('click', function (e) {
    var btn = e.target.closest('.choice-btn');
    if (!btn) return;
    Array.prototype.forEach.call(choiceRow.querySelectorAll('button'), function (b) { b.disabled = true; });
    choiceResponse.textContent = btn.getAttribute('data-msg');
    reveal01.classList.add('open');
    if (!bug01Revealed) { bug01Revealed = true; markBugFound(); }
  });

  /* ---------- slider ---------- */
  var slider = document.getElementById('judgeSlider');
  var sliderReflection = document.getElementById('sliderReflection');
  var sliderMessages = [
    'Rarely - you tend to wait for more of the story.',
    'Sometimes, especially when you\'re tired.',
    'Faster than you\'d probably like to admit.',
    'Before you finish reading the first line.'
  ];
  var sliderTouched = false;
  slider.addEventListener('change', function () {
    sliderReflection.textContent = sliderMessages[slider.value] + ' No score attached to that - Kabir\'s whole doha is just: notice.';
    sliderTouched = true;
  });

  /* ---------- bug 02: postpone + doha reveal ---------- */
  var postponeBtn = document.getElementById('postponeBtn');
  var postponeMsg = document.getElementById('postponeMsg');
  var taskQuote = document.getElementById('taskQuote');
  var reveal02 = document.getElementById('reveal-bug02');
  var postponeMessages = [
    'Deadline approaching...',
    'Still not started.',
    'Procrastination detected.',
    'Scan complete. Revealing relevant doha.'
  ];
  var postponeCount = 0;
  postponeBtn.addEventListener('click', function () {
    postponeMsg.textContent = postponeMessages[postponeCount];
    postponeCount++;
    if (postponeCount >= postponeMessages.length) {
      postponeBtn.disabled = true;
      taskQuote.textContent = '"...tomorrow, probably."';
      reveal02.classList.add('open');
      markBugFound();
    } else {
      taskQuote.style.opacity = '0.55';
      setTimeout(function () { taskQuote.style.opacity = '1'; }, 200);
    }
  });

  /* ---------- manual cards ---------- */
  function wireCard (cardId, patchId) {
    var card = document.getElementById(cardId);
    var patch = document.getElementById(patchId);
    card.addEventListener('click', function () {
      var open = patch.classList.toggle('open');
      card.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }
  wireCard('card1', 'patch1');
  wireCard('card2', 'patch2');

  /* ---------- final diagnostic staged reveal ---------- */
  var terminalCard = document.getElementById('terminalCard');
  var tlines = terminalCard.querySelectorAll('.tline');
  var finalPlayed = false;
  function playFinal () {
    if (finalPlayed) return;
    finalPlayed = true;
    if (reduceMotion) {
      tlines.forEach(function (l) { l.classList.add('show'); });
      return;
    }
    tlines.forEach(function (l, i) {
      setTimeout(function () { l.classList.add('show'); }, i * 420);
    });
  }
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) { playFinal(); obs.disconnect(); }
      });
    }, { threshold: 0.4 });
    obs.observe(terminalCard);
  } else {
    playFinal();
  }
});
</script>

